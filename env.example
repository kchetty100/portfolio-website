# DatoCMS Configuration
# Get your API key from https://www.datocms.com/
# Copy this file to .env and add your actual API key
VITE_DATOCMS_API_KEY=your-datocms-api-key-here

# Optional: DatoCMS Environment
# VITE_DATOCMS_ENVIRONMENT=main

# Optional: Enable/disable mock data fallback
# VITE_USE_MOCK_DATA=true

# Analytics Backend Configuration
# Option 1: Local Express server (run: cd backend && npm install && npm start)
# VITE_ANALYTICS_API_URL=http://localhost:3001/api/analytics/visit

# Option 2: Serverless function (Vercel/Netlify)
# VITE_ANALYTICS_API_URL=https://your-project.vercel.app/api/analytics

# Option 3: Custom backend
# VITE_ANALYTICS_API_URL=https://your-api.com/api/analytics/visit

# Leave empty to use localStorage only (no backend)
# VITE_ANALYTICS_API_URL=